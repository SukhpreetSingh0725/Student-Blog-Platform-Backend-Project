<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/home.css" />
</head>
<body>

  <%- include("../partials/header") %>

  <section class="dashboard-section">

    <div class="dashboard-welcome">
      <h2>⚙️ Admin Dashboard</h2>
      <p>Manage your platform from here</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-icon">👥</span>
        <h3><%= totalUsers %></h3>
        <p>Total Users</p>
      </div>
      <div class="stat-card">
        <span class="stat-icon">📝</span>
        <h3><%= totalBlogs %></h3>
        <p>Total Blogs</p>
      </div>
      <div class="stat-card">
        <span class="stat-icon">❤️</span>
        <h3><%= totalLikes %></h3>
        <p>Total Likes</p>
      </div>
      <div class="stat-card">
        <span class="stat-icon">💬</span>
        <h3><%= totalComments %></h3>
        <p>Total Comments</p>
      </div>
      <div class="stat-card">
        <span class="stat-icon">✉️</span>
        <h3><%= totalMessages %></h3>
        <p>Total Messages</p>
      </div>
    </div>

    <!-- Admin Actions -->
    <div class="dashboard-actions">
      <a href="/admin/users" class="btn-primary">👥 Manage Users</a>
      <a href="/admin/blogs" class="btn-primary">📝 Manage Blogs</a>
      <a href="/admin/messages" class="btn-primary">✉️ View Messages</a>
      <a href="/dashboard" class="btn-secondary">← Back to Dashboard</a>
    </div>

  </section>

  <%- include("../partials/footer") %>

</body>
</html>