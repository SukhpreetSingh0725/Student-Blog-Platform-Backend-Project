<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/css/home.css" />
</head>

<body>

  <%- include("partials/header") %>

    <section class="blog-detail-section">
      <div class="blog-detail-box">

        <% if (blog.coverImage) { %>
          <img src="/uploads/<%= blog.coverImage %>" alt="Cover"
            style="width:100%; max-height:400px; object-fit:cover; border-radius:12px; margin-bottom:25px;">
          <% } %>

            <h1 class="blog-detail-title">
              <%= blog.title %>
            </h1>

            <div class="blog-meta" style="margin-bottom:20px;">
              <img src="/uploads/<%= blog.author.profilePic %>" alt="avatar"
                style="width:40px; height:40px; border-radius:50%; object-fit:cover;">
              <div>
                <strong>
                  <%= blog.author.fullName %>
                </strong>
                <small style="display:block; color:#6b7280;">
                  <%= new Date(blog.createdAt).toDateString() %>
                    · ⏱ <%= readTime %>
                </small>
              </div>
            </div>

            <% if (blog.tags && blog.tags.length> 0) { %>
              <div class="blog-tags" style="margin-bottom:20px;">
                <% blog.tags.forEach(tag=> { %>
                  <span class="tag">#<%= tag %></span>
                  <% }) %>
              </div>
              <% } %>

                <div class="blog-content">
                  <%- blog.content.replace(/\n/g, '<br>' ) %>
                </div>

                <div class="blog-actions">
                  <% if (user) { %>
                    <form action="/blogs/<%= blog._id %>/like" method="POST" style="display:inline;">
                      <button class="btn-like" id="likeBtn">
                        ❤️ <span id="likeCount">
                          <%= blog.likes.length %>
                        </span> Likes
                      </button>
                    </form>
                    <% } else { %>
                      <span class="btn-like">❤️ <span id="likeCount">
                          <%= blog.likes.length %>
                        </span> Likes</span>
                      <% } %>

                        <% if (user && blog.author._id.toString()===user._id.toString()) { %>
                          <a href="/blogs/<%= blog._id %>/edit" class="btn-primary1" style="padding:8px 20px;">Edit</a>
                          <form action="/blogs/<%= blog._id %>/delete" method="POST" style="display:inline;">
                            <button class="btn-danger" style="margin:0;"
                              onclick="return confirm('Delete this blog?')">Delete</button>
                          </form>
                          <% } %>
                </div>

                <div class="comments-section">
                  <h3 id="commentCount">💬 Comments (<%= blog.comments.length %>)</h3>

                  <% if (user) { %>
                    <form action="/blogs/<%= blog._id %>/comment" method="POST" class="comment-form">
                      <textarea name="text" rows="3" placeholder="Write a comment..." required></textarea>
                      <button type="submit" class="btn-primary1" style="margin-top:8px;">Post Comment</button>
                    </form>
                    <% } else { %>
                      <p style="color:#6b7280;"><a href="/signin">Sign in</a> to leave a comment.</p>
                      <% } %>

                        <div class="comments-list" id="commentsList">
                          <% if (blog.comments.length> 0) { %>
                            <% blog.comments.forEach(comment=> { %>
                              <div class="comment-card">
                                <div class="comment-header">
                                  <img src="/uploads/<%= comment.user.profilePic %>" alt="avatar"
                                    style="width:35px; height:35px; border-radius:50%; object-fit:cover;">
                                  <div>
                                    <strong>
                                      <%= comment.user.fullName %>
                                    </strong>
                                    <small style="display:block; color:#6b7280;">
                                      <%= new Date(comment.createdAt).toDateString() %>
                                    </small>
                                  </div>
                                </div>
                                <p class="comment-text">
                                  <%= comment.text %>
                                </p>


                                <% if (user && comment.user._id.toString()===user._id.toString()) { %>
                                  <form action="/blogs/<%= blog._id %>/comment/<%= comment._id %>/delete" method="POST">
                                    <button class="btn-delete-comment">🗑 Delete</button>
                                  </form>
                                  <% } %>

                                    <% if (user && user.isAdmin && comment.user._id.toString() !==user._id.toString()) {
                                      %>
                                      <form action="/admin/blogs/<%= blog._id %>/comment/<%= comment._id %>/delete"
                                        method="POST" onsubmit="return confirm('Delete this comment as admin?')">
                                        <button class="btn-delete-comment" style="color:#e63939;">
                                          ⚙️Delete by Admin
                                        </button>
                                      </form>
                                      <% } %>
                              </div>
                              <% }) %>
                                <% } else { %>
                                  <p id="noComments" style="color:#6b7280; margin-top:15px;">No comments yet. Be the
                                    first!</p>
                                  <% } %>
                        </div>
                </div>

      </div>
    </section>

    <% if (authorBlogs && authorBlogs.length> 0) { %>
      <section class="related-section">
        <h2>✍️ More by <%= blog.author.fullName %>
        </h2>
        <div class="blog-grid">
          <% authorBlogs.forEach(authorBlog=> { %>
            <div class="blog-card">

              <% if (authorBlog.coverImage) { %>
                <img src="/uploads/<%= authorBlog.coverImage %>" alt="Cover"
                  style="width:100%; height:150px; object-fit:cover; border-radius:10px; margin-bottom:10px;">
                <% } %>

                  <h3>
                    <%= authorBlog.title %>
                  </h3>
                  <p>
                    <%= authorBlog.content.substring(0, 100) %>...
                  </p>

                  <div class="blog-meta">
                    <img src="/uploads/<%= authorBlog.author.profilePic %>" alt="avatar"
                      style="width:25px; height:25px; border-radius:50%; object-fit:cover;">
                    <small>By <strong>
                        <%= authorBlog.author.fullName %>
                      </strong></small>
                    <small>⏱ <%= Math.ceil(authorBlog.content.split(" ").length / 200) || 1 %> min read</small>
            </div>

            <div class=" blog-footer">
                        <span>❤️ <%= authorBlog.likes.length %></span>
                        <span>💬 <%= authorBlog.comments.length %></span>
                        <a href="/blogs/<%= authorBlog._id %>">Read More →</a>
                  </div>

                  <% if (authorBlog.tags && authorBlog.tags.length> 0) { %>
                    <div class="blog-tags">
                      <% authorBlog.tags.forEach(tag=> { %>
                        <span class="tag">#<%= tag %></span>
                        <% }) %>
                    </div>
                    <% } %>

            </div>
            <% }) %>
        </div>
      </section>
      <% } %>

        <% if (relatedBlogs && relatedBlogs.length> 0) { %>
          <section class="related-section">
            <h2>📚 You Might Also Like</h2>
            <div class="blog-grid">
              <% relatedBlogs.forEach(related=> { %>
                <div class="blog-card">

                  <% if (related.coverImage) { %>
                    <img src="/uploads/<%= related.coverImage %>" alt="Cover"
                      style="width:100%; height:150px; object-fit:cover; border-radius:10px; margin-bottom:10px;">
                    <% } %>

                      <h3>
                        <%= related.title %>
                      </h3>
                      <p>
                        <%= related.content.substring(0, 100) %>...
                      </p>

                      <div class="blog-meta">
                        <img src="/uploads/<%= related.author.profilePic %>" alt="avatar"
                          style="width:25px; height:25px; border-radius:50%; object-fit:cover;">
                        <small>By <strong>
                            <%= related.author.fullName %>
                          </strong></small>
                        <small>⏱ <%= Math.ceil(related.content.split(" ").length / 200) || 1 %> min read</small>
            </div>

            <div class=" blog-footer">
                            <span>❤️ <%= related.likes.length %></span>
                            <span>💬 <%= related.comments.length %></span>
                            <a href="/blogs/<%= related._id %>">Read More →</a>
                      </div>

                      <% if (related.tags && related.tags.length> 0) { %>
                        <div class="blog-tags">
                          <% related.tags.forEach(tag=> { %>
                            <span class="tag">#<%= tag %></span>
                            <% }) %>
                        </div>
                        <% } %>

                </div>
                <% }) %>
            </div>
          </section>
          <% } %>

            <%- include("partials/footer") %>

              <script src="/socket.io/socket.io.js"></script>
              <script>
                const socket = io();
                const blogId = "<%= blog._id %>";

                socket.emit("joinBlog", blogId);

                socket.on("likeUpdated", (data) => {
                  if (data.blogId === blogId) {
                    document.getElementById("likeCount").textContent = data.likes;
                  }
                });

                socket.on("newComment", (data) => {
                  if (data.blogId === blogId) {
                    document.getElementById("commentCount").textContent =
                      `💬 Comments (${data.totalComments})`;

                    const noComments = document.getElementById("noComments");
                    if (noComments) noComments.remove();

                    const commentsList = document.getElementById("commentsList");
                    const newComment = document.createElement("div");
                    newComment.className = "comment-card";
                    newComment.innerHTML = `
          <div class="comment-header">
            <img src="/uploads/${data.comment.user.profilePic}"
              style="width:35px; height:35px; border-radius:50%; object-fit:cover;">
            <div>
              <strong>${data.comment.user.fullName}</strong>
              <small style="display:block; color:#6b7280;">Just now</small>
            </div>
          </div>
          <p class="comment-text">${data.comment.text}</p>
        `;
                    commentsList.prepend(newComment);
                  }
                });
              </script>

</body>

</html>